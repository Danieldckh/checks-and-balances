# Copy to .env and fill in your GitHub Personal Access Token.
# Create one at: https://github.com/settings/tokens
# Classic token needs scope: repo (full repo access, including private).
# Fine-grained token: read-only access to "Contents" and "Metadata" on all
# your repositories you want included in the report.
GITHUB_TOKEN=ghp_replace_with_your_token

# Absolute path to the Obsidian folder holding YYYY-MM-DD.md daily-log files
# (used by scripts/logs.mjs to fold your work log into the report draft).
OBSIDIAN_DAILY_LOG_DIR=C:\path\to\vault\06 Memory\Daily Log

